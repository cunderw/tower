{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "TowerKit",
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Tower",
      "target-membership": [
        "Tower",
      ],
      "membership-exceptions": [
        {
          "target": "Tower",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "TowerTests", "target-membership": [ "TowerTests" ] },
    { "kind": "folder", "path": "TowerUITests", "target-membership": [ "TowerUITests" ] },
    { "path": "THIRD-PARTY-NOTICES.md", "target-membership": [ "Tower/resources" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Tower.app", "id": "AB01", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TowerTests.xctest", "id": "AB02", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/TowerUITests.xctest", "id": "AB03", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Tower",
      "id": "DB01",
      "product": "Products/Tower.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "TowerCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "TowerData",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGNING_ALLOWED": "YES",
        "CODE_SIGNING_REQUIRED": "NO",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_IDENTITY[sdk=iphoneos*]": "Apple Development",
        "CODE_SIGN_STYLE": "Manual",
        "CODE_SIGN_STYLE[sdk=iphoneos*]": "Automatic",
        "CURRENT_PROJECT_VERSION": "2",
        "DEVELOPMENT_TEAM": "447FMVD577",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Tower/Info.plist",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Tower connects to your Unraid server on your local network to show its status, such as array health and disk temperatures, and to start or stop Docker containers and virtual machines.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "2.0.5",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.cunderw.tower",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "TowerTests",
      "id": "DB02",
      "product": "Products/TowerTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Tower",
      "dependencies": [
        "Tower",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGNING_ALLOWED": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.cunderw.tower.tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Tower.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Tower",
      },
    }, {
      "name": "TowerUITests",
      "id": "DB03",
      "product": "Products/TowerUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "Tower",
      "dependencies": [
        "Tower",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGNING_ALLOWED": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.cunderw.tower.uitests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "Tower",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_VERSION": "6.0",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "27.0",
}
